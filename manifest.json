{
  "manifest_version": 3,
  "name": "No Shorts",
  "version": "1.2.0",
  "description": "Bloque les Shorts sur YouTube : masque toutes les vignettes et sections Shorts et empêche l'ouverture des pages /shorts/.",
  "browser_specific_settings": {
    "gecko": {
      "id": "no-shorts@pierre.local",
      "strict_min_version": "142.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    },
    "gecko_android": {
      "strict_min_version": "142.0"
    }
  },
  "icons": {
    "48": "icon.svg",
    "96": "icon.svg"
  },
  "permissions": [
    "declarativeNetRequest"
  ],
  "host_permissions": [
    "*://www.youtube.com/*",
    "*://m.youtube.com/*",
    "*://youtube.com/*"
  ],
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "shorts_block",
        "enabled": true,
        "path": "rules.json"
      }
    ]
  },
  "web_accessible_resources": [
    {
      "resources": [
        "blocked.html",
        "icon.svg"
      ],
      "matches": [
        "*://*.youtube.com/*"
      ]
    }
  ],
  "content_scripts": [
    {
      "matches": [
        "*://www.youtube.com/*",
        "*://m.youtube.com/*",
        "*://youtube.com/*"
      ],
      "css": [
        "hide-shorts.css"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_start"
    }
  ]
}
